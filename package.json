{
  "name": "eco-mitang-erp",
  "version": "1.0.0",
  "description": "ERP Multi-Tenant e Orientado a Eventos para Holding Offshore, Manufatura e Cursos",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev:api": "npx ts-node src/server.ts",
    "demo": "npx ts-node src/index.ts",
    "db:test": "node scripts/test_connection.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate10": "node scripts/apply_migration_10.js",
    "db:seed": "node scripts/seed_holding.js",
    "test:catalogo": "node scripts/test_catalogo_api.js",
    "test:travas": "node scripts/test_webhook_travas.js",
    "test:eav": "node scripts/test_item_catalogo_eav.js",
    "test:adversarial": "node scripts/test_adversarial_e_clientes.js",
    "test:ofx": "node scripts/test_ofx_ingestion_reais.js",
    "test:xml": "node scripts/test_xml_nfe_ingestion.js",
    "test:baterias": "node scripts/test_baterias_e_orcamentos.js",
    "test:all": "node scripts/test_catalogo_api.js && node scripts/test_webhook_travas.js && node scripts/test_adversarial_e_clientes.js && node scripts/test_ofx_ingestion_reais.js && node scripts/test_xml_nfe_ingestion.js && node scripts/test_baterias_e_orcamentos.js",
    "docs:flow": "node scripts/generate_workflow_diagram.js"
  },
  "keywords": [
    "multi-tenant",
    "event-driven",
    "cqrs",
    "erp",
    "snapshot-pattern",
    "supabase",
    "express",
    "zod",
    "webhooks",
    "eav-jsonb",
    "data-ingestion"
  ],
  "author": "Eco-Mitang Holding",
  "license": "UNLICENSED",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.0",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
