# =============================================================================
# ECO-MITANG ERP -- variaveis de ambiente
# =============================================================================
# Copie para .env e preencha. O .env NUNCA e versionado.
# =============================================================================

# --- Qual banco os scripts alcancam -----------------------------------------
# 'homologacao' (padrao) ou 'producao'.
#
# Deixe em homologacao. Producao tambem pode ser pedida por comando, com
# '--producao' ou pelos atalhos 'npm run db:*:prod' -- e a flag ganha desta
# variavel, para um comando escrito de proposito nao ser contaminado pelo .env.
#
# Toda operacao que escreve em producao pede confirmacao digitada, faz backup
# antes, e exige que a migration ja tenha passado em homologacao.
ECO_AMBIENTE=homologacao

# --- Homologacao: PostgreSQL local em container ------------------------------
# Sobe com: npm run homolog:preparar
# Estas duas linhas sao os PADROES -- so descomente para mudar host ou porta.
# HOMOLOG_MIGRATION_DATABASE_URL="postgresql://postgres:homologacao@localhost:5433/eco_mitang"
# HOMOLOG_APP_DATABASE_URL="postgresql://eco_app:homologacao@localhost:5433/eco_mitang"

# --- Producao: Supabase ------------------------------------------------------
SUPABASE_PROJECT_REF=xbwdjfvhulqdiswkazpn
SUPABASE_URL=https://xbwdjfvhulqdiswkazpn.supabase.co

# APP_DATABASE_URL -- papel 'eco_app', SEM BYPASSRLS. E o que a API usa, e o
# que faz a Row-Level Security valer de fato. Gere com: npm run db:role
APP_DATABASE_URL="postgresql://eco_app.[PROJECT_REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# MIGRATION_DATABASE_URL -- papel privilegiado, so para DDL e scripts de carga.
# A API nunca deve usar esta.
MIGRATION_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Aplicacao ---------------------------------------------------------------
PORT=3000
CORS_ORIGINS=http://localhost:3000
DB_POOL_MAX=10

# Minimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Segredo compartilhado dos webhooks (nao usa JWT).
ECO_WEBHOOK_SECRET=
